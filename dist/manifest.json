{
  "manifest_version": 3,
  "name": "ShopScope",
  "version": "0.1.0",
  "description": "在 Temu 商品页用 1688 以图找货源。",
  "permissions": ["activeTab", "cookies", "storage", "scripting"],
  "host_permissions": [
    "https://www.temu.com/*",
    "https://*.kwcdn.com/*",
    "https://*.1688.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "ShopScope" },
  "content_scripts": [
    {
      "matches": ["https://www.temu.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
